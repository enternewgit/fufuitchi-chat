# このファイルを .env にコピーして値を埋める（.env は絶対にコミットしない）
# cp .env.example .env

# --- Gemini API（開発用。https://aistudio.google.com/apikey で発行） ---
# 設定されていれば Gemini API を使う。チューニング済みモデルを使うときは空にして Vertex AI に切り替える
GEMINI_API_KEY=

# --- Google Cloud（Gemini Enterprise Agent Platform / 旧Vertex AI） ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- 管理者（Google ログイン） ---
# Google Cloud Console で作った OAuth クライアントID（種類: ウェブアプリケーション）。
# 公開してよい値。クライアントシークレットは使わない
GOOGLE_CLIENT_ID=
# 管理者として許可する Google アカウントのメールアドレス（カンマ区切り）
ADMIN_EMAILS=

# --- Backend ---
# Next.js のオリジンだけ許可する
ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend ---
# ブラウザから見た Go API のURL
NEXT_PUBLIC_API_URL=http://localhost:8080
# Next.js のサーバー側から見た Go API のURL（docker compose では上書きされる）
BACKEND_URL=http://localhost:8080

# --- チューニング済みモデル（キャラIDごと） ---
# TUNED_MODEL_<キャラIDを大文字にし - を _ にしたもの> に、チューニング済みモデルのエンドポイントを入れる。
# キャラシートの tunedModel より優先される。プロジェクトごとに違う値なのでリポジトリには入れない
# 例: TUNED_MODEL_TSUKUYOMI=projects/<プロジェクト番号>/locations/us/endpoints/<エンドポイントID>
TUNED_MODEL_TSUKUYOMI=
