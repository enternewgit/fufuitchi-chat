# このファイルを .env にコピーして値を埋める（.env は絶対にコミットしない）
# cp .env.example .env

# --- Gemini API（開発用。https://aistudio.google.com/apikey で発行） ---
# 設定されていれば Gemini API を使う。チューニング済みモデルを使うときは空にして Vertex AI に切り替える
GEMINI_API_KEY=

# --- Google Cloud（Gemini Enterprise Agent Platform / 旧Vertex AI） ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- 管理者 ---
# 長いランダム文字列にする（例: openssl rand -hex 32）
ADMIN_TOKEN=change-me

# --- Backend ---
# Next.js のオリジンだけ許可する
ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend ---
# ブラウザから見た Go API のURL
NEXT_PUBLIC_API_URL=http://localhost:8080
# Next.js のサーバー側から見た Go API のURL（docker compose では上書きされる）
BACKEND_URL=http://localhost:8080
